{
  "name": "dsh-simple-search",
  "version": "1.2.1",
  "private": true,
  "description": "Simple Search: JetBrains-style double-Shift search over file names and the text of every file in the workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoseAustyn/dsh-simple-search.git"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "search.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test tests/search.test.mjs tests/route.test.mjs tests/client.test.mjs",
    "check:syntax": "node --check index.js && node --check search.js && node --check client.js",
    "check:auth": "node scripts/verify-auth-fence.mjs",
    "check:pack": "npm pack --dry-run",
    "check": "npm run check:syntax && npm test && npm run check:auth && npm run check:pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
